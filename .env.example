# LLM (OpenRouter)
OPENROUTER_API_KEY=
# A current cheap model with JSON-schema structured output support
OPENROUTER_MODEL=
# Optional second model, used if the first fails twice
OPENROUTER_MODEL_FALLBACK=

# Mail (IMAP / SMTP)
FINN_MAIL_ADDRESS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_USER=
MAIL_APP_PASSWORD=
POLL_SECONDS=20

# Paths
CONTRACTS_DIR=data/contracts
CACHE_DIR=cache
RUNS_DIR=runs
