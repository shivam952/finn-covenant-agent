# LLM Provider
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Primary model with JSON-schema structured output support
LLM_MODEL=
# Optional fallback model, used if the primary fails twice
LLM_MODEL_FALLBACK=
# Optional JSON object sent as extra_body["provider"] (leave empty to omit)
LLM_PROVIDER_PARAMS_JSON={"require_parameters": true}
# Optional application URL sent as HTTP-Referer header
APP_URL=
LLM_TIME_BUDGET_S=180
LLM_MAX_TOKENS=12000

# Mail (IMAP / SMTP)
FINN_MAIL_ADDRESS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_USER=
MAIL_APP_PASSWORD=
POLL_SECONDS=20

# Presentation & Layout
REPLY_LANGUAGE=de
PLAN_LAYOUT=config/plan_layout.toml

# Paths
CONTRACTS_DIR=data/contracts
CACHE_DIR=cache
RUNS_DIR=runs
